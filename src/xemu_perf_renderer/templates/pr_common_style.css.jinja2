:root {
    --bg: #ffffff;
    --fg: #1f2328;
    --muted: #656d76;
    --border: #d0d7de;
    --row-alt: #f6f8fa;
    --improved: #1a7f37;
    --improved-bg: #dafbe1;
    --regressed: #cf222e;
    --regressed-bg: #ffebe9;
    --link: #0969da;
}

@media (prefers-color-scheme: dark) {
    :root {
        --bg: #0d1117;
        --fg: #e6edf3;
        --muted: #8d96a0;
        --border: #30363d;
        --row-alt: #161b22;
        --improved: #3fb950;
        --improved-bg: #12261e;
        --regressed: #f85149;
        --regressed-bg: #2d1214;
        --link: #4493f8;
    }
}

body {
    background: var(--bg);
    color: var(--fg);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    margin: 0 auto;
    max-width: 1100px;
    padding: 16px;
}

a { color: var(--link); }
.muted { color: var(--muted); }
.note { color: var(--muted); font-style: italic; }

table {
    border-collapse: collapse;
    width: 100%;
    margin: 8px 0 24px;
    font-variant-numeric: tabular-nums;
}

th, td {
    border-bottom: 1px solid var(--border);
    padding: 4px 8px;
    text-align: left;
}

th.num, td.num { text-align: right; }
tbody tr:nth-child(even) { background: var(--row-alt); }
tr.improved td.change { color: var(--improved); background: var(--improved-bg); font-weight: 600; }
tr.regressed td.change { color: var(--regressed); background: var(--regressed-bg); font-weight: 600; }

.summary span { margin-right: 16px; }
.summary .improved { color: var(--improved); }
.summary .regressed { color: var(--regressed); }

.table-wrap { overflow-x: auto; }
details > summary { cursor: pointer; margin: 8px 0; }
